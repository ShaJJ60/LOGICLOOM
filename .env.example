# Required to persist connected repositories and analysis snapshots (Neon PostgreSQL URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional: raises GitHub API limits and allows access to private repositories.
# Keep this server-side; never prefix it with VITE_.
GITHUB_TOKEN=""

# Optional OpenAI-compatible chat completions endpoint. AI explains measured findings only.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
MAX_ANALYSIS_FILES=300
MAX_ANALYSIS_BYTES=10000000
