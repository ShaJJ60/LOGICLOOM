{
  "name": "logicloom-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc -b && tsc -p backend/tsconfig.json && vite build",
    "build:api": "tsc -p backend/tsconfig.json",
    "preview": "vite preview",
    "test:api": "tsx --test backend/src/analyzers/*.test.ts backend/src/github/*.test.ts",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "tsx": "^4.19.2",
    "vite": "^5.4.11"
  }
}
